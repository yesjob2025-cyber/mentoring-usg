# ─────────────────────────────────────────────────────────────
# YESJOB 멘토링 플랫폼 환경변수 예시
# 실제 값은 .env.local 에 넣으세요 (git 에 커밋되지 않음)
# ─────────────────────────────────────────────────────────────

# 세션 쿠키 서명용 시크릿 (32자 이상 임의 문자열)
SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"

# 사이트 기본 URL (알림톡 링크 생성 등에 사용)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── 데이터 백엔드 ─────────────────────────────────────────────
# dev(기본): 로컬 JSON 파일 스토어 (.data/db.json) — 외부 서비스 불필요
# supabase: Supabase Postgres 사용 (아래 키 필요)
DATA_BACKEND="dev"

# ── Supabase (프로덕션 전환 시) ──────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# ── 메시지 발송 ─────────────────────────────────────────────
# provider: stub(기본) | solapi(추천, IP제한 없어 서버리스에 적합) | sms(알리고 문자) | aligo(카카오 알림톡)
KAKAO_PROVIDER="stub"

# 솔라피(Solapi) — HMAC 인증, IP 제한 없음 (Vercel 등 서버리스 권장)
SOLAPI_API_KEY=""
SOLAPI_API_SECRET=""
SOLAPI_SENDER=""         # 솔라피에 등록된 발신번호 (없으면 ALIGO_SENDER 사용)

# 알리고 문자/알림톡 (provider=sms/aligo)
ALIGO_API_KEY=""
ALIGO_USER_ID=""
ALIGO_SENDER=""          # 사전 등록된 발신번호 (숫자만)
ALIGO_TESTMODE="N"       # Y=실제 발송 없이 성공응답만(무과금)
KAKAO_SENDER_KEY=""      # 알림톡 발신프로필(채널) 발신키
# 알림톡 템플릿 코드
KAKAO_TPL_NEW_QUESTION="mentor_new_question"
KAKAO_TPL_NEW_ANSWER="student_new_answer"

# 테스트: 값이 있으면 모든 알림톡을 이 번호로 발송(멘토/학생 무관).
# 여러 멘토에게 질문해도 전부 이 번호로 도착 → 실발송 테스트용. 운영 시 비워두세요.
# TEST_REDIRECT_PHONE="01085536027"

# ── Zoom (토크콘서트 연동, 추후) ─────────────────────────────
# ZOOM_ACCOUNT_ID=""
# ZOOM_CLIENT_ID=""
# ZOOM_CLIENT_SECRET=""
