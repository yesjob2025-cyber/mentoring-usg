# ─────────────────────────────────────────────────────────────
# YESJOB 멘토링 플랫폼 환경변수 예시
# 실제 값은 .env.local 에 넣으세요 (git 에 커밋되지 않음)
# ─────────────────────────────────────────────────────────────

# 세션 쿠키 서명용 시크릿 (32자 이상 임의 문자열)
SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"

# 사이트 기본 URL (알림톡 링크 생성 등에 사용)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── 데이터 백엔드 ─────────────────────────────────────────────
# dev(기본): 로컬 JSON 파일 스토어 (.data/db.json) — 외부 서비스 불필요
# supabase: Supabase Postgres 사용 (아래 키 필요)
DATA_BACKEND="dev"

# ── Supabase (프로덕션 전환 시) ──────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# ── 카카오 알림톡 발송 ──────────────────────────────────────
# provider: stub(기본,콘솔로그) | solapi | nhncloud | aligo
KAKAO_PROVIDER="stub"
# 발신 프로필/채널
KAKAO_SENDER_KEY=""
KAKAO_PLUS_FRIEND_ID=""
# 솔라피(Solapi/CoolSMS)
SOLAPI_API_KEY=""
SOLAPI_API_SECRET=""
# NHN Cloud
NHN_APP_KEY=""
NHN_SECRET_KEY=""
# 알림톡 템플릿 코드
KAKAO_TPL_NEW_QUESTION="mentor_new_question"
KAKAO_TPL_NEW_ANSWER="student_new_answer"

# ── Zoom (토크콘서트 연동, 추후) ─────────────────────────────
# ZOOM_ACCOUNT_ID=""
# ZOOM_CLIENT_ID=""
# ZOOM_CLIENT_SECRET=""
